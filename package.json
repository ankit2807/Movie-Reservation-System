{
  "name": "moviebook-reservation-system",
  "version": "1.0.0",
  "description": "Production-ready full-stack Movie & Live Entertainment Reservation System (MovieBook)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "npm ci --prefix client --include=dev && npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --prefix client",
    "seed": "tsx utils/seedData.ts",
    "lint": "npm run lint --prefix client",
    "review": "tsx tools/code-review-agent.ts"
  },
  "keywords": [
    "movie-reservation",
    "ticketing",
    "react",
    "express",
    "mongodb"
  ],
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.1",
    "multer": "^2.5.0",
    "stripe": "^23.2.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/validator": "^13.15.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
