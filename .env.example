# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/movie-reservation-system

# Authentication (Use at least 32 random bytes in production)
JWT_SECRET=replace_with_a_64_char_random_hex_secret

# Client URL (CORS allowed origins)
FRONTEND_URL=http://localhost:5173

# Optional Seed Credentials (Development Only)
DEMO_USER_PASSWORD=change_me_in_dev
ADMIN_EMAIL=admin@moviebook.com
ADMIN_PASSWORD=change_admin_password

# Stripe Payments (Test or Live keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Third-Party Integrations (Optional)
# Free TMDB API Key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Gemini AI (Optional - for tools/code-review-agent.ts)
GEMINI_API_KEY=your_gemini_api_key_here
